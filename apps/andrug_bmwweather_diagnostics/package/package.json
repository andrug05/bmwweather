{
  "name": "andrug_bmwweather_diagnostics",
  "version": "0.2.0",
  "description": "On-screen BMW Weather Bridge and MGU network diagnostics for iDrive 7",
  "private": false,
  "main": "javascript/runner.js",
  "oapAppSettings": {
    "maxDiskUsage": 10485760,
    "cpuLimit": 30,
    "memoryThresholdKB": 102400,
    "priority": "PRIO_MEDIUM",
    "visibility": "FOREGROUND",
    "latencyClass": "FOREGROUND",
    "loggingId": "BWDI",
    "userLoginRequired": false,
    "backgroundPriority": 100,
    "someipManifest": "manifest.json"
  },
  "files": [
    "config",
    "rhmiData",
    "package.json",
    "npm-shrinkwrap.json",
    "permissions.json",
    "javascript",
    "manifest.json"
  ],
  "dependencies": {
    "oap-sdk": "24.10.2"
  },
  "engines": {
    "node": ">=8.7.0"
  },
  "keywords": ["BMW", "MGU", "ID7", "diagnostics"],
  "author": "Andrug05",
  "license": "MIT",
  "mguLocalOnly": true
}
