[Unit]
Description=BMW ID7 Weather cache bridge (Open-Meteo)
After=network.target mgu-uplink.service
Wants=mgu-uplink.service

[Service]
Type=simple
WorkingDirectory=/var/opt/andrug-bmwweather-bridge/current
Environment=BMW_WEATHER_CONFIG=/var/opt/andrug-bmwweather-bridge/current/config.json
ExecStart=/usr/bin/node /var/opt/andrug-bmwweather-bridge/current/bridge.js
Restart=always
RestartSec=30
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
