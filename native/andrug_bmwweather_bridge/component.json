{
  "id": "andrug_bmwweather_bridge",
  "kind": "tool",
  "version": "0.1.2",
  "title": "BMW Weather Bridge",
  "description": "Feeds the native BMW ID7 Weather cache from Open-Meteo",
  "mguHmi": ["ID7"],
  "uninstallable": true,
  "internet": true,
  "uids": [12214],
  "files": [
    { "path": "bridge.js", "from": "bridge.js", "mode": "0644" },
    { "path": "config.json", "from": "config.json", "mode": "0644" }
  ],
  "units": [
    { "name": "andrug_bmwweather_bridge.service", "from": "andrug_bmwweather_bridge.service" }
  ],
  "enable": [
    { "unit": "andrug_bmwweather_bridge.service", "target": "multi-user.target" }
  ],
  "restart": ["andrug_bmwweather_bridge.service"]
}
